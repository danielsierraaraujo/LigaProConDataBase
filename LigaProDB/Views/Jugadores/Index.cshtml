@model IEnumerable<LigaProDB.Models.Equipo>

@{
    ViewData["Title"] = "Jugadores - Equipos";
}

<h2 class="text-center mb-4">Selecciona un Equipo</h2>

<div class="row">
    @foreach (var equipo in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <img src="~/img/@equipo.Logo" class="card-img-top" style="height: 150px; object-fit: contain;" />
                <div class="card-body text-center">
                    <h5 class="card-title">@equipo.Nombre</h5>
                    <a asp-action="CrearPorEquipo" asp-route-equipoId="@equipo.Id" class="btn btn-success btn-sm me-1">Agregar Jugador</a>
                    <a asp-action="ListaPorEquipo" asp-route-equipoId="@equipo.Id" class="btn btn-primary btn-sm">Ver Jugadores</a>
                </div>
            </div>
        </div>
    }
</div>
