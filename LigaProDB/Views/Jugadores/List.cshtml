@model IEnumerable<LigaProDB.Models.Jugador>
@{
    ViewData["Title"] = "Jugadores del Equipo";
}

<h2 class="text-center mb-4">Jugadores de @ViewBag.NombreEquipo</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered shadow text-center">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Edad</th>
                <th>N° Camiseta</th>
                <th>Posición</th>
                <th>Goles</th>
                <th>Asistencias</th>
                <th>Sueldo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jugador in Model)
            {
                <tr>
                    <td>@jugador.Nombre</td>
                    <td>@jugador.Edad</td>
                    <td>@jugador.NumeroCamiseta</td>
                    <td>@jugador.Posicion</td>
                    <td>@jugador.Goles</td>
                    <td>@jugador.Asistencias</td>
                    <td>$@jugador.Sueldo.ToString("N2")</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@jugador.Id" class="btn btn-sm btn-warning me-2">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <a asp-action="Eliminar" asp-route-id="@jugador.Id" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-secondary mt-4">← Volver a Equipos</a>
