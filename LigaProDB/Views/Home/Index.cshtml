@{
    ViewData["Title"] = "Inicio";
}
<div id="carouselExampleCaptions" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-inner rounded shadow">
        <div class="carousel-item active">
            <img src="/img/futbol1.png" class="d-block w-100" style="height: 400px; object-fit: contain" alt="BSC">
            <div class="carousel-caption d-none d-md-block">
                <h5>Bienvenido a la LigaPro</h5>
                <p>Donde el fútbol ecuatoriano cobra vida.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="/img/futbol3.jpg" class="d-block w-100" style="height: 400px; object-fit: contain" alt="Aucas">
            <div class="carousel-caption d-none d-md-block">
                <h5>Equipos y Jugadores</h5>
                <p>Explora y gestiona los equipos de tu liga favorita.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="/img/futbol2.jpg" class="d-block w-100" style="height: 400px; object-fit: contain" alt="Emelec">
            <div class="carousel-caption d-none d-md-block">
                <h5>Estadísticas</h5>
                <p>Consulta los máximos goleadores y asistencias.</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>

<div class="text-center">
    <h2 class="mb-4">¡Gestiona tu liga con estilo!</h2>
    <a href="/Equipos" class="btn btn-primary btn-lg me-3">Ver Equipos</a>
    <a href="/Jugadores" class="btn btn-success btn-lg">Ver Jugadores</a>
</div>