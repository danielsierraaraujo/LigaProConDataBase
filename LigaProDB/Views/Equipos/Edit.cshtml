@model LigaProDB.Models.Equipo

@{
    ViewData["Title"] = "Editar Equipo";
    var logos = ViewBag.Logos as List<string>;
}

<h2 class="mb-4">Editar Equipo</h2>

<form asp-action="Edit" class="border p-4 rounded shadow-sm bg-light">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Logo" class="form-label">Selecciona un logo</label>
        <select asp-for="Logo" class="form-control" asp-items="@(new SelectList(logos, Model.Logo))">
            <option value="">-- Selecciona un logo --</option>
        </select>
        <span asp-validation-for="Logo" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Logo))
    {
        <div class="mb-3">
            <p class="fw-bold">Logo actual:</p>
            <img src="~/img/@Model.Logo" alt="Logo actual" width="100" class="border rounded" />
        </div>
    }

    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="PartidosJugados" class="form-label"></label>
            <input asp-for="PartidosJugados" class="form-control" />
            <span asp-validation-for="PartidosJugados" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PartidosGanados" class="form-label"></label>
            <input asp-for="PartidosGanados" class="form-control" />
            <span asp-validation-for="PartidosGanados" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PartidosEmpatados" class="form-label"></label>
            <input asp-for="PartidosEmpatados" class="form-control" />
            <span asp-validation-for="PartidosEmpatados" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PartidosPerdidos" class="form-label"></label>
            <input asp-for="PartidosPerdidos" class="form-control" />
            <span asp-validation-for="PartidosPerdidos" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
